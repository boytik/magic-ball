    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access lets you ask the oracle by voice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au micro permet de poser ta question à l'oracle à la voix."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону нужен, чтобы задавать вопросы оракулу голосом."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono ti permette di interrogare l'oracolo con la voce."
          }
