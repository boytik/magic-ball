      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three different oracles, three ways to look at the same question. Pick the voice you want to hear today."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois oracles, trois manières de regarder la même question. Choisis la voix que tu veux entendre aujourd'hui."
