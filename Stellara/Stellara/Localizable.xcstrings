    "about.privacy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your question history is stored only on this device. We don't link it to your identity."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'historique de tes questions reste uniquement sur cet appareil. Nous ne le lions pas à ton identité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia delle tue domande è salvata solo su questo dispositivo. Non la colleghiamo alla tua identità."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История твоих вопросов хранится только на этом устройстве. Мы не привязываем её к твоей личности."
