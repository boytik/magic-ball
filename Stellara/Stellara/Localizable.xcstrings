            "value" : "Зефира"
          }
        }
      }
    },
    "oracle.zephyra.samples" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why do I keep dreaming about the same person?\nIs my heart ready to let someone in?\nWhat is my intuition trying to tell me?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi je rêve encore de la même personne ?\nMon cœur est-il prêt à laisser entrer quelqu'un ?\nQue veut me dire mon intuition ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché continuo a sognare la stessa persona?\nIl mio cuore è pronto a lasciare entrare qualcuno?\nCosa cerca di dirmi la mia intuizione?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почему мне снится один и тот же человек?\nГотово ли моё сердце впустить кого-то?\nЧто пытается сказать мне интуиция?"
          }
        }
      }
    },
