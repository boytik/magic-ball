    "oracle.madame_lou.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A village fortune teller who's seen it all. Madame Lou is direct, sometimes cheeky, and skips the fancy talk. She's the friend who tells you what you need to hear about money, work, family and everyday life."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une voyante de village qui en a vu d'autres. Madame Lou est directe, parfois piquante, sans détours. C'est l'amie qui te dit ce qu'il faut entendre sur l'argent, le travail, la famille et le quotidien."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деревенская гадалка, которая повидала всё. Мадам Лу говорит прямо, иногда с подколом, без красивых слов. Это та подруга, что скажет правду про деньги, работу, семью и обычные будни."
          }
        }
      }
    },
    "oracle.madame_lou.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madame Lou"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madame Lou"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мадам Лу"
          }
        }
      }
    },
    "oracle.madame_lou.samples" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Should I quit this job?\nWill we get along with my mother-in-law?\nIs this purchase actually a good idea?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devrais-je quitter ce travail ?\nVais-je m'entendre avec ma belle-mère ?\nCet achat est-il vraiment une bonne idée ?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стоит ли уйти с этой работы?\nПолучится ли поладить со свекровью?\nЭта покупка — правда хорошая идея?"
          }
        }
      }
    },
