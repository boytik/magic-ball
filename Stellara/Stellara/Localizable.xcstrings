    "oracle.zephyra.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lunar mystic who speaks in soft, dreamy phrases. Zephyra listens to feelings between the lines and answers with metaphor — the moon, water, breath. Best when you want to look inward, not outward."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mystique lunaire qui parle en phrases douces et rêveuses. Zephyra écoute les émotions entre les lignes et répond par métaphores — la lune, l'eau, le souffle. Idéale quand tu veux regarder en toi, pas autour de toi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una mistica lunare che parla con frasi morbide e oniriche. Zephyra ascolta i sentimenti tra le righe e risponde con metafore — la luna, l'acqua, il respiro. Perfetta quando vuoi guardare dentro, non fuori."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лунная мистика, говорит мягко и образно. Зефира слышит то, что между строк, и отвечает метафорами — про луну, воду, дыхание. Хороша, когда хочется заглянуть внутрь, а не вовне."
          }
        }
      }
    },
    "oracle.zephyra.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zephyra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zéphira"
          }
        },
        "it" : {
          "stringUnit" : {
