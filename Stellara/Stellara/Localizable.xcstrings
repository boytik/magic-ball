      }
    },
    "oracle.cosmo.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cosmic guide tuned to the bigger picture. Cosmo speaks with energy and a wide horizon, talking in terms of paths, signals and momentum. Best when you're standing at a fork in the road and want a wider view."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un guide cosmique branché sur la vue d'ensemble. Cosmo parle avec énergie et un large horizon, en termes de chemins, de signaux et d'élan. Idéal quand tu es à un carrefour et veux prendre du recul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una guida cosmica sintonizzata sul quadro più ampio. Cosmo parla con energia e ampi orizzonti, in termini di percorsi, segnali e slancio. Perfetto quando sei a un bivio e vuoi una visione d'insieme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Космический проводник, настроенный на большую картину. Космо говорит с энергией и широким горизонтом — про пути, сигналы и импульс. Хорош, когда ты на развилке и хочется увидеть карту целиком."
          }
        }
      }
    },
    "oracle.cosmo.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
