    "oracle.cosmo.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cosmic guide tuned to the bigger picture. Cosmo speaks with energy and a wide horizon, talking in terms of paths, signals and momentum. Best when you're standing at a fork in the road and want a wider view."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un guide cosmique branché sur la vue d'ensemble. Cosmo parle avec énergie et un large horizon, en termes de chemins, de signaux et d'élan. Idéal quand tu es à un carrefour et veux prendre du recul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Космический проводник, настроенный на большую картину. Космо говорит с энергией и широким горизонтом — про пути, сигналы и импульс. Хорош, когда ты на развилке и хочется увидеть карту целиком."
          }
        }
      }
    },
    "oracle.cosmo.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosmo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosmo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Космо"
          }
        }
      }
    },
    "oracle.cosmo.samples" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's the next big chapter for me?\nIs this move worth it?\nWhich path has more momentum behind it?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle est ma prochaine grande étape ?\nCe changement vaut-il le coup ?\nQuel chemin a le plus d'élan ?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какая моя следующая большая глава?\nСтоит ли этот переход того?\nУ какого пути больше импульса?"
          }
        }
      }
    },
