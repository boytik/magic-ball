    "about.disclaimer.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellara's predictions are AI-generated entertainment. They are not a substitute for medical, legal, or financial advice. If you're going through a difficult moment, please reach out to a professional or someone you trust."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prédictions de Stellara sont un divertissement généré par IA. Elles ne remplacent pas les conseils médicaux, juridiques ou financiers d'un professionnel. Si tu traverses un moment difficile, contacte un professionnel ou un proche."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предсказания Stellara — развлекательный контент, генерируемый AI. Они не заменяют профессиональные медицинские, юридические или финансовые консультации. Если ты переживаешь сложный момент — обратись к специалисту или близким."
          }
        }
      }
    },
    "about.disclaimer.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For entertainment purposes only."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
