    "oracle.madame_lou.samples" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Should I quit this job?\nWill we get along with my mother-in-law?\nIs this purchase actually a good idea?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devrais-je quitter ce travail ?\nVais-je m'entendre avec ma belle-mère ?\nCet achat est-il vraiment une bonne idée ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovrei lasciare questo lavoro?\nAndremo d'accordo con la suocera?\nÈ davvero una buona idea quest'acquisto?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стоит ли уйти с этой работы?\nПолучится ли поладить со свекровью?\nЭта покупка — правда хорошая идея?"
          }
        }
      }
    },
