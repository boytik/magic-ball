    "about.disclaimer.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellara's predictions are AI-generated entertainment. They are not a substitute for medical, legal, or financial advice. If you're going through a difficult moment, please reach out to a professional or someone you trust."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prédictions de Stellara sont un divertissement généré par IA. Elles ne remplacent pas les conseils médicaux, juridiques ou financiers d'un professionnel. Si tu traverses un moment difficile, contacte un professionnel ou un proche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le predizioni di Stellara sono intrattenimento generato dall'IA. Non sostituiscono consulenze mediche, legali o finanziarie. Se stai attraversando un momento difficile, rivolgiti a un professionista o a una persona di fiducia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предсказания Stellara — развлекательный контент, генерируемый AI. Они не заменяют профессиональные медицинские, юридические или финансовые консультации. Если ты переживаешь сложный момент — обратись к специалисту или близким."
          }
        }
      }
    },
    "about.disclaimer.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For entertainment purposes only."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour le divertissement uniquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo per intrattenimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For entertainment purposes only."
          }
        }
      }
    },
    "about.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pocket AI oracle. Ask anything and get a mystical answer from one of three characters."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un oracle IA de poche. Pose une question et reçois une réponse mystique de l'un des trois personnages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un oracolo IA da tasca. Fai una domanda e ricevi una risposta mistica da uno dei tre personaggi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-оракул в кармане. Спроси что-нибудь и получи мистический ответ от одного из трёх персонажей."
          }
        }
      }
    },
